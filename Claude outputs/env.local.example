# Supabase — get these from your project dashboard at supabase.com
# Settings → API → Project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: only needed for server-side admin operations, and for the
# Playwright suite in tests/workbench-pro.spec.ts (it needs to grant a
# disposable test account Pro in the database, bypassing Stripe, to test
# reordering workspace tabs — a Pro-only feature). Get it from Supabase
# Dashboard → Settings → API → "service_role" key (NOT the anon key —
# this one bypasses row-level security, keep it out of version control
# and only ever put it in your own .env.local, never here).
# Without it, tests/workbench-pro.spec.ts skips itself automatically.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
